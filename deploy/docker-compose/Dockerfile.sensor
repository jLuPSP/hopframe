FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download || true
COPY . .
RUN CGO_ENABLED=0 go build -o /out/mcp-sensor ./cmd/mcp-sensor

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/mcp-sensor /usr/local/bin/mcp-sensor
ENTRYPOINT ["/usr/local/bin/mcp-sensor"]
CMD ["--config", "/etc/hopframe/mcp-sensor.yaml"]
