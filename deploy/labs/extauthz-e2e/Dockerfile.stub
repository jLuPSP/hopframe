# Self-contained stub upstream for the lab, kept hermetic so the lab builds
# without reaching outside its own folder. Matches go.mod's go1.25 toolchain
# (the shared deploy/docker-compose Dockerfiles are bumped to 1.25 too).
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download || true
COPY . .
RUN CGO_ENABLED=0 go build -o /out/stub-mcp-server ./cmd/stub-mcp-server

FROM alpine:3.20
RUN apk add --no-cache wget
COPY --from=build /out/stub-mcp-server /usr/local/bin/stub-mcp-server
EXPOSE 8088
ENTRYPOINT ["/usr/local/bin/stub-mcp-server"]
CMD ["--addr", ":8088"]
