# Homelab preset.
#
# For a small team running Hopframe inside their own VPC. Bearer-token
# auth, per-record signing, hot-reloadable policy plane, sensor fleet
# inventory. No OIDC, no Rekor anchoring, no per-tenant scoping.
#
# Generate the bearer token before sourcing:
#
#   export HOPFRAME_API_TOKEN=$(openssl rand -hex 32)
#   source examples/config/homelab.env
#   ./bin/control-plane
#
# The signing key is generated on first boot if the file does not
# exist, so a fresh deployment is a single command. Persist the
# generated key file alongside the audit log; the public key embedded
# in signed exports must match across deployments to keep verifications
# valid.

# Listen on the default control-plane port. Bind to 0.0.0.0 so sensors
# inside the VPC can reach it.
export HOPFRAME_CONTROL_PLANE_ADDR="0.0.0.0:7090"

# Append-only audit log.
export HOPFRAME_CONTROL_PLANE_LOG="data/events.ndjson"

# 90 days retention. Tighten for high-traffic deployments; loosen for
# audit-heavy ones.
export HOPFRAME_CONTROL_PLANE_RETENTION="2160h"

# Bearer-token auth on /v1/*. Set HOPFRAME_API_TOKEN before sourcing.
# The legacy single-token mode is the admin scope; tenant scoping is a
# Secured-mode feature.
: "${HOPFRAME_API_TOKEN:?HOPFRAME_API_TOKEN must be set; generate with openssl rand -hex 32}"

# Per-record Ed25519 signing. The seed file is created if missing.
export HOPFRAME_SIGNING_KEY="data/signing.seed"

# Policy plane: persistent JSON store + audit-chain listener.
export HOPFRAME_POLICY_PATH="data/policies.json"

# Sensor fleet inventory: heartbeats land in /v1/sensors.
export HOPFRAME_SENSOR_FLEET="1"

# OTA detection-content delivery from the bundled rule packs. Sensors
# fetch the manifest on heartbeat and apply changes without restart.
export HOPFRAME_CONTENT_ROOT="content"

# Optional per-IP rate limit on /v1/* requests. Comment out to disable.
export HOPFRAME_RATE_LIMIT_RPS="200"

# Built-in user management. When HOPFRAME_USERS_PATH is set, the operator
# UI redirects to /login when no session cookie is present. The admin
# user is created on first boot from HOPFRAME_BOOTSTRAP_ADMIN=user:pass
# (only when the user file is empty).
export HOPFRAME_USERS_PATH="data/users.json"
# export HOPFRAME_BOOTSTRAP_ADMIN="admin:change-me-now"

# Optional webhook exporter into your SIEM. Configure these to upstream
# every finding into Splunk, Datadog, Sentry, etc.
# export HOPFRAME_WEBHOOK_URL="https://siem.internal/hooks/hopframe"
# export HOPFRAME_WEBHOOK_SECRET="$(openssl rand -hex 32)"
# export HOPFRAME_WEBHOOK_MIN_SEVERITY="medium"
