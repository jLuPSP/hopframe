# Secured preset.
#
# For regulated buyers and multi-tenant operators. Everything in
# Homelab preset plus per-tenant token scoping, role-bound tokens,
# OIDC SSO with id_token JWKS verification, Rekor anchoring of chain
# heads, Layer 3 LLM judge for the uncertain band.
#
# Required environment before sourcing:
#
#   export HOPFRAME_API_TOKEN=$(openssl rand -hex 32)
#   export HOPFRAME_TENANT_TOKENS="..."         # comma-separated token:tenant
#   export HOPFRAME_ROLE_TOKENS="..."           # comma-separated token:role
#   export HOPFRAME_OIDC_ISSUER="https://login.acme.com"
#   export HOPFRAME_OIDC_CLIENT_ID="..."
#   export HOPFRAME_OIDC_CLIENT_SECRET="..."
#   export HOPFRAME_OIDC_REDIRECT_URL="https://hopframe.acme.svc/auth/callback"

# Bind on the control-plane address; assume mTLS terminates upstream.
export HOPFRAME_CONTROL_PLANE_ADDR="0.0.0.0:7090"
export HOPFRAME_CONTROL_PLANE_LOG="data/events.ndjson"
export HOPFRAME_CONTROL_PLANE_RETENTION="8760h"  # 365 days

# Admin (cross-tenant) bearer.
: "${HOPFRAME_API_TOKEN:?HOPFRAME_API_TOKEN must be set}"

# Tenant scoping: every per-tenant token forces event.tenant_id on
# write and filters reads to the bound tenant. Format:
# token1:tenantA,token2:tenantB
: "${HOPFRAME_TENANT_TOKENS:?HOPFRAME_TENANT_TOKENS must be set}"

# Role scoping: tokens map to viewer | policy_author | tenant_admin |
# super_admin. Composes with tenant scoping.
: "${HOPFRAME_ROLE_TOKENS:?HOPFRAME_ROLE_TOKENS must be set}"

# OIDC SSO. Discovery URL is derived from issuer.
: "${HOPFRAME_OIDC_ISSUER:?HOPFRAME_OIDC_ISSUER must be set}"
: "${HOPFRAME_OIDC_CLIENT_ID:?HOPFRAME_OIDC_CLIENT_ID must be set}"
: "${HOPFRAME_OIDC_CLIENT_SECRET:?HOPFRAME_OIDC_CLIENT_SECRET must be set}"
: "${HOPFRAME_OIDC_REDIRECT_URL:?HOPFRAME_OIDC_REDIRECT_URL must be set}"
export HOPFRAME_OIDC_DEFAULT_ROLE="viewer"

# Cryptographic audit
export HOPFRAME_SIGNING_KEY="data/signing.seed"

# Sigstore Rekor anchoring of chain heads. Set _DISABLED=1 to keep the
# code path live without making outbound calls (useful in air-gapped
# environments; enable a private Rekor on the same URL otherwise).
export HOPFRAME_REKOR_URL="https://rekor.sigstore.dev"
# export HOPFRAME_REKOR_DISABLED="1"

# Policy plane
export HOPFRAME_POLICY_PATH="data/policies.json"

# Sensor fleet inventory
export HOPFRAME_SENSOR_FLEET="1"

# OTA detection-content delivery
export HOPFRAME_CONTENT_ROOT="content"

# Rate limit per IP on /v1/*
export HOPFRAME_RATE_LIMIT_RPS="500"

# Built-in user management for the operator UI. Local users coexist with
# OIDC SSO; an OIDC login mints a session, a local-user login mints
# another, and the auth middleware accepts either as a session cookie.
export HOPFRAME_USERS_PATH="data/users.json"
# export HOPFRAME_BOOTSTRAP_ADMIN="admin:change-me-now"

# Layer 3 LLM judge. Optional; runs only on the uncertain band. Speaks
# OpenAI Chat Completions wire format, so OpenAI / Anthropic compat /
# Ollama / vLLM / LiteLLM all work as backends.
# export HOPFRAME_LLM_JUDGE_URL="http://litellm.internal:4000/v1/chat/completions"
# export HOPFRAME_LLM_JUDGE_API_KEY="..."
# export HOPFRAME_LLM_JUDGE_MODEL="claude-3-5-haiku-latest"

# SIEM upstream
# export HOPFRAME_WEBHOOK_URL="https://siem.acme.com/hooks/hopframe"
# export HOPFRAME_WEBHOOK_SECRET="$(openssl rand -hex 32)"
# export HOPFRAME_WEBHOOK_MIN_SEVERITY="medium"
# export HOPFRAME_SPLUNK_URL="https://splunk.acme.com/services/collector"
# export HOPFRAME_SPLUNK_TOKEN="..."
# export HOPFRAME_SPLUNK_INDEX="hopframe"
