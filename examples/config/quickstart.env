# Quickstart preset.
#
# For a single developer evaluating Hopframe on a laptop. No auth, no
# policies, no signing. Inline detection plus the operator UI runs as
# soon as the binary boots.
#
# Use:
#   source examples/config/quickstart.env
#   ./bin/control-plane &
#   ./bin/mcp-sensor --config examples/config/mcp-sensor.yaml
#
# Or just run `make demo` which sets up the same shape automatically.

export HOPFRAME_CONTROL_PLANE_ADDR=":7090"
export HOPFRAME_CONTROL_PLANE_LOG="data/events.ndjson"
